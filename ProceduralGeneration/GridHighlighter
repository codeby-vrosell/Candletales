    public Coroutine startAreaAnimation(HashSet<Vector2Int> cells, System.Func<Vector2Int> getCenter, bool expand, System.Action onComplete = null, System.Func<Vector2Int, bool> isValidCell = null, System.Func<Color> getColor = null, HashSet<Vector2Int> cellsToAnimate = null, float speedMultiplier = 1f, string overrideMaterial = null) {

        return StartCoroutine(areaAnimation(cells, getCenter, expand, onComplete, isValidCell, getColor, cellsToAnimate, speedMultiplier, overrideMaterial));

    }

    private void assignPlayerWhenSpawn() {

        if (playerMover == null) {

            GameObject playerGameObject = GameObject.FindGameObjectWithTag("Player");

            if (playerGameObject != null && playerGameObject.transform.parent != null) {

                playerGameObject = playerGameObject.transform.parent.gameObject;

            }

            if (playerGameObject == null) {

                return;

            }

            playerMover = playerGameObject.GetComponent<PlayerControllerBase>();

        }
    }

    private void handleHover() {

        Vector2 mousePosition = Mouse.current.position.ReadValue();
        Ray ray = Camera.main.ScreenPointToRay(mousePosition);

        LayerMask combinedMask = interactablesLayer | enemyLayer;
        int hitCount = Physics.RaycastNonAlloc(ray, raycastResults, Mathf.Infinity, combinedMask);

        Cell bestCell = null;
        IInteractable bestInteractable = null;
        Transform bestInteractableTransform = null;
        Transform bestEnemyTransform = null;

        float minimumCellDistance = float.MaxValue;
        float minimumInteractableDistance = float.MaxValue;

        for (int i = 0; i < hitCount; i = i + 1) {

            RaycastHit hit = raycastResults[i];
            GameObject hitObject = hit.collider.gameObject;
            Cell hitCell = getCellFromHit(hit);

            if (hitCell != null && hit.distance < minimumCellDistance) {

                minimumCellDistance = hit.distance;
                bestCell = hitCell;

            }

            IInteractable interactable = hitObject.GetComponentInParent<IInteractable>();

            if (interactable != null && interactable.canInteract() == true && hit.distance < minimumInteractableDistance) {

                minimumInteractableDistance = hit.distance;
                bestInteractable = interactable;
                bestInteractableTransform = ((MonoBehaviour)interactable).transform;

                if (isInLayerMask(hitObject, enemyLayer) == true) {

                    bestEnemyTransform = bestInteractableTransform;

                }
            }
        }

        if (bestInteractable != null) {

            Vector2Int interactableGridPosition = gridManager.worldToGridPosition(bestInteractableTransform.position);
            bool hasInteractableCell = gridManager.getCells().TryGetValue(interactableGridPosition, out Cell interactableCell);

            if (hasInteractableCell == true) {

                bestCell = interactableCell;

            }
        }

        bool targetChanged = false;

        if (bestEnemyTransform != hoveredEnemyTransform) {

            if (hoveredEnemyTransform != null) {

                Outliner previousOutliner = hoveredEnemyTransform.GetComponent<Outliner>();

                if (previousOutliner != null) {

                    previousOutliner.enabled = false;

                }
            }

            hoveredEnemyTransform = bestEnemyTransform;

            if (hoveredEnemyTransform != null) {

                Outliner newOutliner = hoveredEnemyTransform.GetComponent<Outliner>();

                if (newOutliner != null) {

                    newOutliner.enabled = true;

                }
            }

            targetChanged = true;

        }

        if (bestInteractable != lastHoveredInteractable) {

            lastHoveredInteractable = bestInteractable;
            targetChanged = true;

        }

        if (bestCell != null) {

            hoverCellCoords = bestCell.gridPosition;
            hoverCellWalkable = bestCell.isWalkable;
            visibleGrid = true;

            bool pathInvalidated = false;

            if (currentPathCells.Count > 0) {

                for (int j = 0; j < currentPathCells.Count; j = j + 1) {

                    Cell pathCell = currentPathCells[j];

                    if (pathCell.isWalkable == false || pathCell.currentStateOfCell == Cell.StateOfCell.occupied) {

                        if (j == 0) {

                            continue;

                        }

                        bool isGoal = (j == currentPathCells.Count - 1);

                        if (isGoal == true && bestInteractable != null) {

                            continue;

                        }

                        pathInvalidated = true;
                        break;

                    }
                }
            }

            if (bestCell != lastHoveredCell || currentPathCells.Count == 0 || targetChanged == true || pathInvalidated == true) {

                resetHighlight();

                bool isReachable = false;
                List<Vector2Int> targetPath = null;
                Vector2Int startPosition = Vector2Int.zero;
                Vector2Int goalPosition = bestCell.gridPosition;

                if (playerMover != null && gridAnimations.centerAnimationEnded == true) {

                    startPosition = playerMover.getCurrentGridPos();

                    if (bestInteractable != null) {

                        List<Vector2Int> targetFootprint = bestInteractable.getFootprint();

                        if (isAdjacentToFootprint(startPosition, targetFootprint) == true) {

                            goalPosition = startPosition;

                        }

                        else {

                            int infiniteRange = 999;
                            goalPosition = playerMover.selectCloserWalkableCellToTargetInRange(bestInteractableTransform, infiniteRange);

                        }
                    }

                    if (startPosition == goalPosition) {

                        isReachable = true;

                    }

                    else {

                        targetPath = Pathfinder.findPath(startPosition, goalPosition, gridManager.getCells());
                        
                        if (targetPath != null && targetPath.Count > 0) {

                            isReachable = true;

                        }

                        else {

                            isReachable = false;

                        }
                    }
                }

                Color targetColor;
                bool shouldBlockCursor = false;

                if (hoveredEnemyTransform != null) {

                    targetColor = hoverBlockedColor;
                    shouldBlockCursor = false;

                }

                else if (bestInteractable != null && isReachable == true) {

                    targetColor = hoverInteractColor;
                    shouldBlockCursor = false;

                }

                else if (bestCell.isWalkable == true && isReachable == true) {

                    targetColor = hoverColor;
                    shouldBlockCursor = false;

                }

                else {

                    targetColor = hoverBlockedColor;
                    shouldBlockCursor = true;

                }

                if (CursorManager.Instance != null) {

                    CursorManager.Instance.setBlockedState(shouldBlockCursor);

                }

                setHoverMaterial(bestCell, targetColor, 1f, hoverFillAlpha, hoverThickness);
                lastHoveredCell = bestCell;

                if (isReachable == true && targetPath != null && targetPath.Count > 0) {

                    int maximumCells = PlayerManager.Instance.cellsPerTurn;

                    if (playerMover != null && playerMover.isMoving == true) {

                        if (playerMover.currentPathLeft != null && playerMover.currentPathLeft.Count > 1) {

                            Vector2Int currentJumpDestination = playerMover.currentPathLeft[1];

                            if (playerMover.getCurrentGridPos() == currentJumpDestination) {

                                bool hasJumpCell = gridManager.getCells().TryGetValue(currentJumpDestination, out Cell jumpCell);

                                if (hasJumpCell == true) {

                                    maximumCells = maximumCells - jumpCell.movementCost;
                                    maximumCells = Mathf.Max(0, maximumCells);

                                }
                            }
                        }
                    }

                    int precalculatedCost = 0;

                    foreach (Vector2Int pathPosition in targetPath) {

                        currentPathPositions.Add(pathPosition);
                        bool hasCellData = gridManager.getCells().TryGetValue(pathPosition, out Cell currentCell);

                        if (hasCellData == true) {

                            if (pathPosition != startPosition) {

                                precalculatedCost = precalculatedCost + currentCell.movementCost;

                            }

                            if (precalculatedCost <= maximumCells && maximumCells > 0) {

                                validPathPositions.Add(pathPosition);

                            }
                        }
                    }

                    int currentPathCost = 0;
                    Vector2Int visualGoalPosition;

                    if (bestInteractable != null) {

                        visualGoalPosition = new Vector2Int(-99999, -99999);

                    }

                    else {

                        visualGoalPosition = goalPosition;

                    }

                    foreach (Vector2Int targetPosition in targetPath) {

                        bool hasPathCell = gridManager.getCells().TryGetValue(targetPosition, out Cell pathCell);

                        if (hasPathCell == false) {

                            continue;

                        }

                        if (targetPosition != startPosition) {

                            currentPathCost = currentPathCost + pathCell.movementCost;

                        }

                        if (targetPosition == goalPosition) {

                            if (bestInteractable != null) {

                                if (currentPathCost <= maximumCells && maximumCells > 0) {

                                    setPathMaterial(pathCell, pathColor, 1f, pathFillAlpha, currentPathPositions, validPathPositions, visualGoalPosition);

                                }

                                else {

                                    setPathMaterial(pathCell, unpathColor, 1f, pathFillAlpha, currentPathPositions, validPathPositions, visualGoalPosition);

                                }
                            }

                            else {

                                setPathMaterial(pathCell, targetColor, 1f, hoverFillAlpha, currentPathPositions, validPathPositions, visualGoalPosition);

                            }
                        }

                        else {

                            if (currentPathCost <= maximumCells && maximumCells > 0) {

                                setPathMaterial(pathCell, pathColor, 1f, pathFillAlpha, currentPathPositions, validPathPositions, visualGoalPosition);

                            }

                            else {

                                setPathMaterial(pathCell, unpathColor, 1f, pathFillAlpha, currentPathPositions, validPathPositions, visualGoalPosition);

                            }
                        }

                        currentPathCells.Add(pathCell);

                    }
                }
            }

            if (playerMover != null && playerMover.isMoving == false) {

                if (bestInteractable != null) {

                    Vector2Int myGridPosition = playerMover.getCurrentGridPos();

                    if (isAdjacentToFootprint(myGridPosition, bestInteractable.getFootprint()) == true) {

                        Vector3 positionTarget = bestInteractableTransform.position; 
                        positionTarget.y = 0f;
                        playerMover.lookPos = positionTarget;

                    }

                    else if (currentPathCells.Count > 1) {

                        Vector3 nextPosition = gridManager.gridToWorldPosition(currentPathCells[1].gridPosition);
                        playerMover.lookPos = nextPosition;

                    }
                }

                else if (currentPathCells.Count > 1) {

                    Vector3 nextPosition = gridManager.gridToWorldPosition(currentPathCells[1].gridPosition);
                    playerMover.lookPos = nextPosition;

                }
            }
        }

        else {

            if (hoveredEnemyTransform != null) {

                Outliner outlinerComponent = hoveredEnemyTransform.GetComponent<Outliner>();

                if (outlinerComponent != null) {

                    outlinerComponent.enabled = false;

                }

                hoveredEnemyTransform = null;

            }

            visibleGrid = false;
            resetHighlight();

        }
    }

    private bool isAdjacentToFootprint(Vector2Int myPosition, List<Vector2Int> targetFootprint) {

        Vector2Int[] directions = { Vector2Int.up, Vector2Int.down, Vector2Int.left, Vector2Int.right };

        foreach (Vector2Int direction in directions) {

            if (targetFootprint.Contains(myPosition + direction) == true) {

                return true;

            }
        }

        return false;

    }

    private bool isAdjacent(Vector2Int positionA, Vector2Int positionB) {

        return Mathf.Abs(positionA.x - positionB.x) + Mathf.Abs(positionA.y - positionB.y) == 1;

    }

    private bool isInLayerMask(GameObject targetObject, LayerMask mask) {

        return (mask.value & (1 << targetObject.layer)) != 0;

    }

    private void resetHighlight() {

        if (lastHoveredCell != null) {

            setHoverMaterial(lastHoveredCell, Color.clear, 0f, 0f, 0.1f);
            lastHoveredCell = null;

        }

        foreach (var pathCell in currentPathCells) {

            setPathMaterial(pathCell, Color.clear, 0f, 0f, null, null, new Vector2Int(-999, -999));

        }

        currentPathCells.Clear();
        currentPathPositions.Clear();
        validPathPositions.Clear();
        invalidPathPositions.Clear();

        if (CursorManager.Instance != null) {

            CursorManager.Instance.setBlockedState(false);

        }
    }

    private void setHoverMaterial(Cell cell, Color color, float targetAlpha, float fillAlpha, float thickness) {

        applyMaterialProperties(cell, gridMaterialName, propertyBlock => {

            propertyBlock.SetColor(baseColorId, color);
            propertyBlock.SetColor(fillColorId, color);
            propertyBlock.SetFloat(alphaId, targetAlpha);
            propertyBlock.SetFloat(fillAlphaId, fillAlpha);
            propertyBlock.SetFloat(outlineThicknessId, thickness);

            propertyBlock.SetFloat(hideTopId, 0f); 
            propertyBlock.SetFloat(hideBottomId, 0f);
            propertyBlock.SetFloat(hideRightId, 0f); 
            propertyBlock.SetFloat(hideLeftId, 0f);
            propertyBlock.SetFloat(hideTopRightId, 0f); 
            propertyBlock.SetFloat(hideTopLeftId, 0f);
            propertyBlock.SetFloat(hideBottomRightId, 0f); 
            propertyBlock.SetFloat(hideBottomLeftId, 0f);

            propertyBlock.SetFloat(cutTopId, 0f); 
            propertyBlock.SetFloat(cutBottomId, 0f);
            propertyBlock.SetFloat(cutRightId, 0f); 
            propertyBlock.SetFloat(cutLeftId, 0f);

        });
    }

    private void setPathMaterial(Cell cell, Color color, float targetAlpha, float fillAlpha, HashSet<Vector2Int> allPath, HashSet<Vector2Int> validPath, Vector2Int goalPosition) {

        int getZone(Vector2Int zonePosition) {

            if (zonePosition == goalPosition) {

                return 2;

            }

            if (validPath != null && validPath.Contains(zonePosition) == true) {

                return 1;

            }

            return 0;

        }

        applyMaterialProperties(cell, gridMaterialName, propertyBlock => {

            propertyBlock.SetColor(baseColorId, color);
            propertyBlock.SetColor(fillColorId, color);
            propertyBlock.SetFloat(alphaId, targetAlpha);
            propertyBlock.SetFloat(fillAlphaId, fillAlpha);
            propertyBlock.SetFloat(outlineThicknessId, pathThickness);

            if (allPath != null && allPath.Count > 0) {

                Vector2Int cellPosition = cell.gridPosition;

                bool hasTopNeighbor = allPath.Contains(cellPosition + new Vector2Int(0, 1));
                bool hasBottomNeighbor = allPath.Contains(cellPosition + new Vector2Int(0, -1));
                bool hasRightNeighbor = allPath.Contains(cellPosition + new Vector2Int(1, 0));
                bool hasLeftNeighbor = allPath.Contains(cellPosition + new Vector2Int(-1, 0));

                bool hasTopRightNeighbor = allPath.Contains(cellPosition + new Vector2Int(1, 1));
                bool hasTopLeftNeighbor = allPath.Contains(cellPosition + new Vector2Int(-1, 1));
                bool hasBottomRightNeighbor = allPath.Contains(cellPosition + new Vector2Int(1, -1));
                bool hasBottomLeftNeighbor = allPath.Contains(cellPosition + new Vector2Int(-1, -1));

                float topValue;

                if (hasTopNeighbor == true) {

                    topValue = 1f;

                }

                else {

                    topValue = 0f;

                }

                propertyBlock.SetFloat(hideTopId, topValue);

                float bottomValue;

                if (hasBottomNeighbor == true) {

                    bottomValue = 1f;

                }

                else {

                    bottomValue = 0f;

                }

                propertyBlock.SetFloat(hideBottomId, bottomValue);

                float rightValue;

                if (hasRightNeighbor == true) {

                    rightValue = 1f;

                }

                else {

                    rightValue = 0f;

                }

                propertyBlock.SetFloat(hideRightId, rightValue);

                float leftValue;

                if (hasLeftNeighbor == true) {

                    leftValue = 1f;

                }

                else {

                    leftValue = 0f;

                }

                propertyBlock.SetFloat(hideLeftId, leftValue);

                float topRightValue;

                if (hasTopRightNeighbor == true) {

                    topRightValue = 1f;

                }

                else {

                    topRightValue = 0f;

                }

                propertyBlock.SetFloat(hideTopRightId, topRightValue);

                float topLeftValue;

                if (hasTopLeftNeighbor == true) {

                    topLeftValue = 1f;

                }

                else {

                    topLeftValue = 0f;

                }

                propertyBlock.SetFloat(hideTopLeftId, topLeftValue);

                float bottomRightValue;

                if (hasBottomRightNeighbor == true) {

                    bottomRightValue = 1f;

                }

                else {

                    bottomRightValue = 0f;

                }

                propertyBlock.SetFloat(hideBottomRightId, bottomRightValue);

                float bottomLeftValue;

                if (hasBottomLeftNeighbor == true){

                    bottomLeftValue = 1f;

                }

                else {

                    bottomLeftValue = 0f;

                }

                propertyBlock.SetFloat(hideBottomLeftId, bottomLeftValue);

                int myZone = getZone(cellPosition);
                bool cutTop = false, cutBottom = false, cutRight = false, cutLeft = false;

                if (hasTopNeighbor == true) {

                    if (getZone(cellPosition + new Vector2Int(0, 1)) != myZone) {

                        cutTop = true;

                    }
                }

                if (hasBottomNeighbor == true) {

                    if (getZone(cellPosition + new Vector2Int(0, -1)) != myZone) {

                        cutBottom = true;

                    }
                }

                if (hasRightNeighbor == true) {

                    if (getZone(cellPosition + new Vector2Int(1, 0)) != myZone) {

                        cutRight = true;

                    }
                }

                if (hasLeftNeighbor == true) {

                    if (getZone(cellPosition + new Vector2Int(-1, 0)) != myZone) {

                        cutLeft = true;

                    }
                }

                if (cutTop == true) {

                    propertyBlock.SetFloat(cutTopId, 1f);

                }

                else {

                    propertyBlock.SetFloat(cutTopId, 0f);

                }

                if (cutBottom == true) {

                    propertyBlock.SetFloat(cutBottomId, 1f);

                }

                else {

                    propertyBlock.SetFloat(cutBottomId, 0f);

                }

                if (cutRight == true) {

                    propertyBlock.SetFloat(cutRightId, 1f);

                }

                else {

                    propertyBlock.SetFloat(cutRightId, 0f);

                }

                if (cutLeft == true) {

                    propertyBlock.SetFloat(cutLeftId, 1f);

                }

                else {

                    propertyBlock.SetFloat(cutLeftId, 0f);

                }
            }

            else {

                propertyBlock.SetFloat(hideTopId, 0f);
                propertyBlock.SetFloat(hideBottomId, 0f);
                propertyBlock.SetFloat(hideRightId, 0f);
                propertyBlock.SetFloat(hideLeftId, 0f);
                propertyBlock.SetFloat(hideTopRightId, 0f);
                propertyBlock.SetFloat(hideTopLeftId, 0f);
                propertyBlock.SetFloat(hideBottomRightId, 0f);
                propertyBlock.SetFloat(hideBottomLeftId, 0f);

                propertyBlock.SetFloat(cutTopId, 0f);
                propertyBlock.SetFloat(cutBottomId, 0f);
                propertyBlock.SetFloat(cutRightId, 0f);
                propertyBlock.SetFloat(cutLeftId, 0f);

            }
        });
    }

    private void setAreaCell(Cell cell, HashSet<Vector2Int> areaPositions, float overrideProgress, float outlineAlpha, Color color, System.Func<Vector2Int, bool> isValidCell = null, bool isPerception = false, string overrideMaterial = null) {

        Vector2Int cellPosition = cell.gridPosition;

        bool hasTopNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(0, 1), areaPositions, isValidCell, isPerception);
        bool hasBottomNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(0, -1), areaPositions, isValidCell, isPerception);
        bool hasRightNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(1, 0), areaPositions, isValidCell, isPerception);
        bool hasLeftNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(-1, 0), areaPositions, isValidCell, isPerception);

        bool hasTopRightNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(1, 1), areaPositions, isValidCell, isPerception);
        bool hasTopLeftNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(-1, 1), areaPositions, isValidCell, isPerception);
        bool hasBottomRightNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(1, -1), areaPositions, isValidCell, isPerception);
        bool hasBottomLeftNeighbor = areCellsInSamePlane(cellPosition, cellPosition + new Vector2Int(-1, -1), areaPositions, isValidCell, isPerception);

        string targetMaterial;

        if (overrideMaterial != null) {

            targetMaterial = overrideMaterial;

        }

        else {

            targetMaterial = areaMaterialName;

        }

        applyMaterialProperties(cell, targetMaterial, propertyBlock => {

            propertyBlock.SetColor(baseColorId, color);
            propertyBlock.SetColor(fillColorId, color);
            propertyBlock.SetFloat(alphaId, 1f);
            propertyBlock.SetFloat(fillAlphaId, areaFillAlpha);
            propertyBlock.SetFloat(outlineThicknessId, areaThickness);

            if (hasTopNeighbor == true) {

                propertyBlock.SetFloat(hideTopId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideTopId, 0f);

            }

            if (hasBottomNeighbor == true) {

                propertyBlock.SetFloat(hideBottomId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideBottomId, 0f);

            }

            if (hasRightNeighbor == true) {

                propertyBlock.SetFloat(hideRightId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideRightId, 0f);

            }

            if (hasLeftNeighbor == true) {

                propertyBlock.SetFloat(hideLeftId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideLeftId, 0f);

            }

            if (hasTopRightNeighbor == true) {

                propertyBlock.SetFloat(hideTopRightId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideTopRightId, 0f);

            }

            if (hasTopLeftNeighbor == true) {

                propertyBlock.SetFloat(hideTopLeftId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideTopLeftId, 0f);

            }

            if (hasBottomRightNeighbor == true) {

                propertyBlock.SetFloat(hideBottomRightId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideBottomRightId, 0f);

            }

            if (hasBottomLeftNeighbor == true) {

                propertyBlock.SetFloat(hideBottomLeftId, 1f);

            }

            else {

                propertyBlock.SetFloat(hideBottomLeftId, 0f);

            }

            propertyBlock.SetFloat(cutTopId, 0f); 
            propertyBlock.SetFloat(cutBottomId, 0f);
            propertyBlock.SetFloat(cutRightId, 0f); 
            propertyBlock.SetFloat(cutLeftId, 0f);

            if (overrideProgress >= 0f) {

                propertyBlock.SetFloat(animationProgressId, overrideProgress);

            }

            propertyBlock.SetFloat(showOutlineId, outlineAlpha);

        });
    }

    public void updateAreaInstant(HashSet<Vector2Int> areaPositions, bool isAnimating = false, Color? overrideColor = null, System.Func<Vector2Int, bool> isValidCell = null) {

        Color selectedColor;

        if (overrideColor != null) {

            selectedColor = overrideColor.Value;

        }

        else {

            selectedColor = endAttackAreaColor;

        }

        foreach (Vector2Int position in areaPositions) {

            if (isValidCell != null && isValidCell(position) == false) {

                continue;

            }

            bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

            if (cellExists == true) {

                if (isAnimating == true) {

                    setAreaCell(targetCell, areaPositions, -1f, 0f, selectedColor, isValidCell);

                }

                else {

                    setAreaCell(targetCell, areaPositions, 1f, 1f, selectedColor, isValidCell);

                }
            }
        }
    }

    public void updateAreaColor(HashSet<Vector2Int> areaPositions, Color color) {

        foreach (Vector2Int position in areaPositions) {

            bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

            if (cellExists == true) {

                applyMaterialProperties(targetCell, areaMaterialName, propertyBlock => {

                    propertyBlock.SetColor(baseColorId, color);
                    propertyBlock.SetColor(fillColorId, color);

                });
