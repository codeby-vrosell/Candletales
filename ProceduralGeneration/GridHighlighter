    private void applyMaterialProperties(Cell targetCell, string materialName, System.Action<MaterialPropertyBlock> applyChanges) {

        if (targetCell.visual == null) {

            return;

        }

        Renderer meshRenderer = targetCell.visual.GetComponent<Renderer>();

        if (meshRenderer == null) {

            return;

        }

        var materials = meshRenderer.sharedMaterials;
        int targetIndex = -1;

        for (int i = 0; i < materials.Length; i = i + 1) {

            if (materials[i] != null && materials[i].name.Contains(materialName) == true) {

                targetIndex = i;
                break;

            }
        }

        if (targetIndex == -1) {

            return;

        }

        MaterialPropertyBlock propertyBlock = new MaterialPropertyBlock();
        meshRenderer.GetPropertyBlock(propertyBlock, targetIndex);
        
        applyChanges(propertyBlock);
        
        meshRenderer.SetPropertyBlock(propertyBlock, targetIndex);

    }

    private int getAttacksHash() {

        int combinedHash = 0;

        foreach (var attackSystem in AttackSystem.allSystems) {

            foreach (var currentCast in attackSystem.casts.Values) {

                combinedHash = combinedHash ^ currentCast.cells.Count;

                foreach (var castCell in currentCast.cells) {

                    combinedHash = combinedHash ^ castCell.GetHashCode();

                }
            }
        }

        return combinedHash;

    }

    private Cell getCellFromHit(RaycastHit raycastHit) {

        int instanceId = raycastHit.collider.GetInstanceID();
        bool cellFound = gridManager.colliderToCellMap.TryGetValue(instanceId, out Cell targetCell);

        if (cellFound == true) {

            return targetCell;

        }

        return null;

    }

