    private void reloadPath() {

        bool needsRefresh = false;

        if (PlayerManager.Instance.cellsPerTurn != lastCellsPerTurn) {

            lastCellsPerTurn = PlayerManager.Instance.cellsPerTurn;
            needsRefresh = true;

        }

        if (playerMover != null) {

            Vector2Int currentPosition = playerMover.getCurrentGridPos();

            if (currentPosition != lastPlayerGridPosition) {

                lastPlayerGridPosition = currentPosition;
                needsRefresh = true;

            }
        }

        if (needsRefresh == true && lastHoveredCell != null) {

            resetHighlight();

        }
    }

