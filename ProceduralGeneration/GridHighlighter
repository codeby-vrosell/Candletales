    public void clearCells(IEnumerable<Vector2Int> cellsToClear) {

        foreach (Vector2Int position in cellsToClear) {

            if (cellsBeingAnimatedOut.Contains(position) == true) {

                continue;

            }

            bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

            if (cellExists == true) {

                if (currentPerceptionCells.Contains(position) == false) {

                    applyMaterialProperties(targetCell, perceptionMaterialName, propertyBlock => {

                        propertyBlock.SetFloat(alphaId, 0f);
                        propertyBlock.SetFloat(fillAlphaId, 0f);
                        propertyBlock.SetFloat(showOutlineId, 0f);

                    });
                }

                applyMaterialProperties(targetCell, areaMaterialName, propertyBlock => {

                    propertyBlock.SetFloat(alphaId, 0f);
                    propertyBlock.SetFloat(fillAlphaId, 0f);
                    propertyBlock.SetFloat(showOutlineId, 0f);

                });
            }
        }
    }

    public IEnumerator areaAnimation(HashSet<Vector2Int> areaPositions, System.Func<Vector2Int> getCenter, bool expand, System.Action onComplete = null, System.Func<Vector2Int, bool> isValidCell = null, System.Func<Color> getColor = null, HashSet<Vector2Int> cellsToAnimate = null, float speedMultiplier = 1f, string overrideMaterial = null)  {

        float currentDuration = areaAnimationDuration / speedMultiplier;
        float currentDelay = areaAnimationCellDelay / speedMultiplier;

        if (expand == true) {

            Color initialColor;

            if (getColor != null) {

                initialColor = getColor();

            }

            else {

                initialColor = endAttackAreaColor;

            }

            foreach (Vector2Int position in areaPositions) {

                if (isValidCell != null && isValidCell(position) == false) {

                    continue;

                }

                if (cellsToAnimate != null && cellsToAnimate.Contains(position) == false) {

                    continue;

                }

                bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

                if (cellExists == true) {

                    setAreaCell(targetCell, areaPositions, 0f, 0f, initialColor, isValidCell, false, overrideMaterial);

                }
            }
        }

        float timer = 0f;

        while (true) {

            timer = timer + ClockManager.Instance.internalDeltaTime;
            bool isAllDone = true;
            Color currentColor;

            if (getColor != null) {

                currentColor = getColor();

            }

            else {

                currentColor = endAttackAreaColor;

            }

            Vector2Int centerPosition = getCenter();
            int maximumRadius = 0;

            foreach (var position in areaPositions) {

                int currentDistance = Mathf.Abs(position.x - centerPosition.x) + Mathf.Abs(position.y - centerPosition.y);

                if (currentDistance > maximumRadius) {

                    maximumRadius = currentDistance;

                }
            }

            bool hasAnimatedCells;

            if (cellsToAnimate != null) {

                hasAnimatedCells = cellsToAnimate.Count > 0;

            }

            else {

                hasAnimatedCells = areaPositions.Count > 0;

            }

            if (hasAnimatedCells == false && timer < 0.2f) {

                isAllDone = false;

            }

            foreach (Vector2Int position in areaPositions) {

                if (isValidCell != null && isValidCell(position) == false) {

                    continue;

                }

                if (cellsToAnimate != null && cellsToAnimate.Contains(position) == false) {

                    bool staticCellExists = gridManager.getCells().TryGetValue(position, out Cell staticCell);

                    if (staticCellExists == true) {

                        setAreaCell(staticCell, areaPositions, 1f, 1f, currentColor, isValidCell, false, overrideMaterial);

                    }

                    continue;

                }

                int currentDistance = Mathf.Abs(position.x - centerPosition.x) + Mathf.Abs(position.y - centerPosition.y);
                float animationDelay;

                if (expand == true) {

                    animationDelay = currentDistance * currentDelay;

                }

                else {

                    animationDelay = (maximumRadius - currentDistance) * currentDelay;

                }

                float animationProgress = Mathf.Clamp01((timer - animationDelay) / currentDuration);

                if (animationProgress < 1f) {

                    isAllDone = false;

                }

                float smoothedProgress = Mathf.SmoothStep(0f, 1f, animationProgress);
                float finalScale;

                if (expand == true) {

                    finalScale = smoothedProgress;

                }

                else {

                    finalScale = 1f - smoothedProgress;

                }

                bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

                if (cellExists == true) {

                    setAreaCell(targetCell, areaPositions, finalScale, 0f, currentColor, isValidCell, false, overrideMaterial);

                }
            }

            if (isAllDone == true || timer > 10f) {

                break;

            }

            yield return null;

        }

        if (expand == true) {

            Color finalColor;

            if (getColor != null) {

                finalColor = getColor();

            }

            else {

                finalColor = endAttackAreaColor;

            }

            foreach (Vector2Int position in areaPositions) {

                if (isValidCell != null && isValidCell(position) == false) {

                    continue;

                }

                bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

                if (cellExists == true) {

                    setAreaCell(targetCell, areaPositions, 1f, 1f, finalColor, isValidCell, false, overrideMaterial);

                }
            }
        }

        else {

            foreach (Vector2Int position in areaPositions) {

                if (isValidCell != null && isValidCell(position) == false) {

                    continue;

                }

                if (cellsToAnimate != null && cellsToAnimate.Contains(position) == false) {

                    continue;

                }

                bool cellExists = gridManager.getCells().TryGetValue(position, out Cell targetCell);

                if (cellExists == true) {

                    string targetMaterial;

                    if (overrideMaterial != null) {

                        targetMaterial = overrideMaterial;

                    }

                    else {

                        targetMaterial = areaMaterialName;

                    }

                    applyMaterialProperties(targetCell, targetMaterial, propertyBlock => {

                        propertyBlock.SetFloat(alphaId, 0f);
                        propertyBlock.SetFloat(fillAlphaId, 0f);
                        propertyBlock.SetFloat(showOutlineId, 0f);

                    });
                }
            }
        }

        if (onComplete != null) {

            onComplete.Invoke();

        }
    }

    public void forceClearVisual(GameObject visualObject) {

        if (visualObject == null) {

            return;

        }

        Renderer[] meshRenderers = visualObject.GetComponentsInChildren<Renderer>();

        foreach (Renderer meshRenderer in meshRenderers) {

            for (int i = 1; i < meshRenderer.sharedMaterials.Length; i = i + 1) {

                MaterialPropertyBlock propertyBlock = new MaterialPropertyBlock();

                meshRenderer.GetPropertyBlock(propertyBlock, i);

                propertyBlock.SetFloat(alphaId, 0f);
                propertyBlock.SetFloat(fillAlphaId, 0f);
                propertyBlock.SetFloat(showOutlineId, 0f);

                meshRenderer.SetPropertyBlock(propertyBlock, i);

            }
        }
    }

    private bool areCellsInSamePlane(Vector2Int myPosition, Vector2Int neighborPosition, HashSet<Vector2Int> areaPositions, System.Func<Vector2Int, bool> isValidCell = null, bool isPerception = false) {

        bool isNeighborInSameAttack = areaPositions.Contains(neighborPosition);

        if (isNeighborInSameAttack == true && isValidCell != null) {

            if (isValidCell(neighborPosition) == false) {

                isNeighborInSameAttack = false;

            }
        }

        if (isPerception == true && isNeighborInSameAttack == true) {

            return true;

        }

        bool isNeighborInFusibleAttack = false;

        if (isNeighborInSameAttack == false && isPerception == false) {

            float myTimeRemaining = -1f;
            bool foundMyCast = false;

            foreach (var attackSystem in AttackSystem.allSystems) {

                foreach (var activeCast in attackSystem.casts.Values) {

                    if (activeCast.cells == areaPositions) {

                        myTimeRemaining = 1f - activeCast.timer;
                        foundMyCast = true;
                        break;

                    }
                }

                if (foundMyCast == true) {

                    break;

                }
            }

            if (foundMyCast == true) {

                float otherMinimumTimeRemaining = float.MaxValue;
                bool foundOtherCast = false;

                foreach (var attackSystem in AttackSystem.allSystems) {

                    foreach (var otherCast in attackSystem.casts.Values) {

                        if (otherCast.cells.Contains(neighborPosition) == true) {

                            float timeRemaining = 1f - otherCast.timer;

                            if (timeRemaining < otherMinimumTimeRemaining) {

                                otherMinimumTimeRemaining = timeRemaining;
                                foundOtherCast = true;

                            }
                        }
                    }
                }

                if (foundOtherCast == true) {

                    float timeTolerance = 0.1f;
                    bool isSynchronized = Mathf.Abs(myTimeRemaining - otherMinimumTimeRemaining) <= timeTolerance;
                    bool areBothLocked = myTimeRemaining <= 0.01f && otherMinimumTimeRemaining <= 0.01f;

                    if (isSynchronized == true || areBothLocked == true) {

                        isNeighborInFusibleAttack = true;

                    }
                }
            }
        }

        if (isNeighborInSameAttack == false && isNeighborInFusibleAttack == false) {

            return false;

        }

        bool myCellExists = gridManager.getCells().TryGetValue(myPosition, out Cell myCell);

        if (myCellExists == true) {

            bool neighborCellExists = gridManager.getCells().TryGetValue(neighborPosition, out Cell neighborCell);

            if (neighborCellExists == true) {

                if (myCell.visual != null && neighborCell.visual != null) {

                    float myHeight = myCell.visual.transform.localPosition.y;
                    float neighborHeight = neighborCell.visual.transform.localPosition.y;

                    return Mathf.Abs(myHeight - neighborHeight) <= 0.05f;

                }
            }

            else {

                return true;

            }
        }

        return false;

    }

    private void handleGridFade() {

        if (visibleGrid == true) {

            targetGridAlpha = visibleAlpha;

        }

        else {

            targetGridAlpha = hiddenAlpha;

        }

        currentGridAlpha = Mathf.Lerp(currentGridAlpha, targetGridAlpha, Time.deltaTime * fadeSpeed);
        applyAlphaToGrid(currentGridAlpha);

    }

    private void applyAlphaToGrid(float targetAlpha) {

        if (gridManager == null) {

            return;

        }

        foreach (var keyValuePair in gridManager.getCells()) {

            Cell targetCell = keyValuePair.Value;

            if (targetCell == null || targetCell.visual == null) {

                continue;

            }

            applyMaterialProperties(targetCell, borderMaterialName, propertyBlock => {

                propertyBlock.SetFloat(alphaId, targetAlpha);

            });
        }
    }

    private void handlePerceptionAreas() {

        HashSet<Vector2Int> newPerceptionCells = new HashSet<Vector2Int>();
        HashSet<EnemyBase> currentPerceivingEnemies = new HashSet<EnemyBase>();

        int currentEnemyStateHash = 17;
        Vector2Int centerPosition = gridManager.gridCenter;

        foreach (var attackSystem in AttackSystem.allSystems) {

            EnemyBase enemyComponent = attackSystem.GetComponent<EnemyBase>();

            if (enemyComponent != null && enemyComponent.currentState != EnemyBase.states.Death) {

                if (enemyComponent.currentState == EnemyBase.states.Patrolling && enemyComponent.enteredCombat == false && enemyComponent.playerDetected == false) {

                    unchecked {

                        currentEnemyStateHash = currentEnemyStateHash * 31 + enemyComponent.currentGridPos.GetHashCode();
                        currentEnemyStateHash = currentEnemyStateHash * 31 + enemyComponent.perceptionRange;

                    }

                    newPerceptionCells.UnionWith(enemyComponent.getPerceptionCells());
                    currentPerceivingEnemies.Add(enemyComponent);

                }
            }
        }

        bool enemiesChanged = currentEnemyStateHash != lastEnemyStateHash;
        lastEnemyStateHash = currentEnemyStateHash;

        bool gridMovedThisFrame = false;
        Vector2Int currentPlayerPosition;

        if (playerMover != null) {

            currentPlayerPosition = playerMover.getCurrentGridPos();

        }

        else {

            currentPlayerPosition = Vector2Int.zero;

        }

        bool centerChanged = gridManager.gridCenter != lastGridCenter;
        bool playerMoved = currentPlayerPosition != lastPlayerGridPosition;

        if (centerChanged == true || playerMoved == true || enemiesChanged == true) {

            lastGridCenter = gridManager.gridCenter;
            lastPlayerGridPosition = currentPlayerPosition;

            updateVirtualPerceptionCache();
            gridMovedThisFrame = true;

        }

        newPerceptionCells.UnionWith(cachedVirtualPerception);

        bool enemyLostPerceptionThisFrame = false;
        Vector2Int animationCenter = Vector2Int.zero;
        int lostCount = 0;
        bool instantClear = false;

        foreach (var oldEnemy in perceivingEnemies) {

            if (oldEnemy == null || oldEnemy.currentState != EnemyBase.states.Patrolling || oldEnemy.enteredCombat == true || oldEnemy.playerDetected == true) {

                enemyLostPerceptionThisFrame = true;

                if (oldEnemy != null) {

                    animationCenter = animationCenter + gridManager.worldToGridPosition(oldEnemy.transform.position);
                    lostCount = lostCount + 1;

                }
            }
        }

        if (lostCount > 1) {

            animationCenter = new Vector2Int(animationCenter.x / lostCount, animationCenter.y / lostCount);

        }

        perceivingEnemies = currentPerceivingEnemies;

        int currentAttackHash = getAttacksHash();
        bool attacksChanged = currentAttackHash != lastAttackHash;
        lastAttackHash = currentAttackHash;

        if (gridMovedThisFrame == false && forcePerceptionRepaint == false && currentPerceptionCells.SetEquals(newPerceptionCells) == true && attacksChanged == false) {

            return;

        }

        forcePerceptionRepaint = false;

        HashSet<Vector2Int> cellsToClear = new HashSet<Vector2Int>(currentPerceptionCells);
        cellsToClear.ExceptWith(newPerceptionCells);
        currentPerceptionCells = newPerceptionCells;

        if (enemyLostPerceptionThisFrame == true && cellsToClear.Count > 0) {

            if (instantClear == true) {

                clearCells(cellsToClear);

            }

            else {

                Vector2Int temporaryCenter = animationCenter;
                HashSet<Vector2Int> snapshotNewCells = new HashSet<Vector2Int>(newPerceptionCells);

                cellsBeingAnimatedOut.UnionWith(cellsToClear);

                startAreaAnimation(cellsToClear, () => temporaryCenter, false, () => { cellsBeingAnimatedOut.ExceptWith(cellsToClear); }, null, () => perceptionAreaColor, null, 1f, perceptionMaterialName);
            }
        }

        else if (cellsToClear.Count > 0) {

            clearCells(cellsToClear);

        }

        if (currentPerceptionCells.Count > 0) {

            updatePerceptionInstant(currentPerceptionCells);

        }
    }

    private int getEnemyPerceptionRange(TileType enemyType) {

        bool hasCache = enemyPerceptionCache.TryGetValue(enemyType, out int rangeCache);

        if (hasCache == true) {

            return rangeCache;

        }

        if (enemyType.prefab != null) {

            EnemyBase enemyScript = enemyType.prefab.GetComponentInChildren<EnemyBase>(true);

            if (enemyScript != null) {

                enemyPerceptionCache[enemyType] = enemyScript.perceptionRange;
                return enemyScript.perceptionRange;

            }
        }

        enemyPerceptionCache[enemyType] = 0;
        return 0;

    }

    public void updateVirtualPerceptionCache() {

        cachedVirtualPerception.Clear();

        if (gridManager == null) {

            return;

        }

        int halfWidth = gridManager.visibleWidth / 2;
        int halfHeight = gridManager.visibleHeight / 2;

        Vector2Int centerPosition = gridManager.gridCenter;
        int safeRange = Mathf.Max(maxPerceptionRange, 6);

        if (biomeGenerator != null) {

            biomeGenerator.clearDistantPredictionCache(centerPosition, halfWidth + safeRange + 2);

        }

        for (int positionX = -halfWidth - safeRange; positionX <= halfWidth + safeRange; positionX = positionX + 1) {

            for (int positionY = -halfHeight - safeRange; positionY <= halfHeight + safeRange; positionY = positionY + 1) {

                Vector2Int targetPosition = centerPosition + new Vector2Int(positionX, positionY);

                bool isOutOfBounds = Mathf.Abs(targetPosition.x - centerPosition.x) > halfWidth || Mathf.Abs(targetPosition.y - centerPosition.y) > halfHeight;

                if (isOutOfBounds == false) {

                    bool cellExists = gridManager.getCells().TryGetValue(targetPosition, out Cell targetCell) && targetCell.visual != null;

                    if (cellExists == true) {

                        continue;

                    }
                }

                TileType virtualEnemyType = gridManager.getPredictedEnemyAt(targetPosition);

                if (virtualEnemyType != null) {

                    int perceptionRange = getEnemyPerceptionRange(virtualEnemyType);

                    for (int perceptionX = -perceptionRange; perceptionX <= perceptionRange; perceptionX = perceptionX + 1) {

                        for (int perceptionY = -perceptionRange; perceptionY <= perceptionRange; perceptionY = perceptionY + 1) {

                            cachedVirtualPerception.Add(targetPosition + new Vector2Int(perceptionX, perceptionY));

                        }
                    }
                }
            }
        }

        forcePerceptionRepaint = true;

    }

