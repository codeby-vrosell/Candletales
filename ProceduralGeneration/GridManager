    public Vector2Int worldToGridPosition(Vector3 worldPosition) {

        Vector3 localPosition = worldPosition - transform.position;
        return new Vector2Int(Mathf.RoundToInt(localPosition.x / cellSize), Mathf.RoundToInt(localPosition.z / cellSize));

    }

    public Vector3 gridToWorldPosition(Vector2Int gridPosition) {

        tryGetCells(gridPosition, out Cell targetCell);
        float currentHeight;

        if (targetCell != null && targetCell.visual != null) {

            currentHeight = targetCell.visual.transform.position.y;

        }

        else {

            currentHeight = 0f;

        }

        return transform.position + new Vector3(gridPosition.x * cellSize, currentHeight, gridPosition.y * cellSize);

    }

    public void checkForDamageableObjectOnCell(Vector2Int positionInGrid, out GameObject objectInCell) {

        objectInCell = null;
        bool hasCell = tryGetCells(positionInGrid, out Cell targetCell);

        if (hasCell == true) {

            if (targetCell != null && targetCell.visual != null) {

                AttackSystem targetAttackSystem = targetCell.visual.transform.GetComponentInChildren<AttackSystem>();

                if (targetAttackSystem != null) {

                    objectInCell = targetAttackSystem.gameObject;

                }
            }
        }
    }

    public void refreshCellVisualsAt(Vector2Int gridPosition) {

        bool hasCell = cells.TryGetValue(gridPosition, out Cell targetCell);

        if (hasCell == true) {

            if (targetCell.minY > 0f) {

                targetCell.tileType = null;
                targetCell.layerType = MultiTileLayer.None;
                targetCell.isWalkable = true;

                if (gridHighlighter != null) {

                    gridHighlighter.refreshHoverAndPath();

                }

                return;

            }

            List<Transform> entitiesToRescue = new List<Transform>();

            if (targetCell.visual != null) {

                foreach (Transform childTransform in targetCell.visual.transform) {

                    if (childTransform.gameObject.name != "DestroyParticleSystem") {

                        entitiesToRescue.Add(childTransform);

                    }
                }

                foreach (Transform rescueTransform in entitiesToRescue) {

                    rescueTransform.SetParent(transform, true);

                }

                Destroy(targetCell.visual);

            }

            createCleanCellAt(gridPosition);

            bool newCellCreated = cells.TryGetValue(gridPosition, out Cell newTargetCell);

            if (newCellCreated == true) {

                if (newTargetCell.visual != null) {

                    newTargetCell.visual.SetActive(true);

                    foreach (Transform rescueTransform in entitiesToRescue) {

                        rescueTransform.SetParent(newTargetCell.visual.transform, true);

                    }
                }
            }

            if (gridHighlighter != null) {

                gridHighlighter.refreshHoverAndPath();

            }
        }
    }

    public void unreservePosition(Vector2Int gridPosition) {

        bool isReserved = reservedPositions.Contains(gridPosition);

        if (isReserved == true) {

            reservedPositions.Remove(gridPosition);

        }
    }

    private void OnDrawGizmosSelected() {

        var currentCellsDictionary = getCells();

        if (currentCellsDictionary == null) {

            return;

        }

        foreach (var currentCell in currentCellsDictionary) {

            // --- LAYER 1: Cell State (y = 2) ---
            Vector3 worldPosition = gridToWorldPosition(currentCell.Key);
            worldPosition.y = 2f;

            switch (currentCell.Value.currentStateOfCell) {

                case Cell.StateOfCell.available:
                    Gizmos.color = Color.green;
                    Gizmos.DrawWireSphere(worldPosition, 0.25f);
                    break;

                case Cell.StateOfCell.transit:
                    Gizmos.color = Color.yellow;
                    Gizmos.DrawWireSphere(worldPosition, 0.25f);
                    break;

                case Cell.StateOfCell.occupied:
                    Gizmos.color = Color.red;
                    Gizmos.DrawWireSphere(worldPosition, 0.25f);
                    break;

            }

            // --- LAYER 2: Walkable (y = 4) ---
            worldPosition.y = 4f;

            if (currentCell.Value.isWalkable == true) {

                Gizmos.color = Color.cyan;
                Gizmos.DrawWireSphere(worldPosition, 0.25f);

            }

            else {

                Gizmos.color = Color.purple;
                Gizmos.DrawWireSphere(worldPosition, 0.25f);

            }

            // --- LAYER 3: Occupied By Entity (y = 6) ---
            worldPosition.y = 6f;

            if (currentCell.Value.occupiedByEntity == true) {

                // Blue to highlight that there is an entity
                Gizmos.color = Color.blue;
                Gizmos.DrawWireSphere(worldPosition, 0.25f);

            }

            else {

                // White (and slightly smaller) to indicate there is NO entity without cluttering the screen
                Gizmos.color = Color.white;
                Gizmos.DrawWireSphere(worldPosition, 0.15f);

            }
        }
    }

    public List<Vector2Int> getObstacleFootprint(Vector2Int gridPosition) {

        List<Vector2Int> targetFootprint = new List<Vector2Int>();
        Vector2Int anchorPosition = gridPosition;
        TileType obstacleType = null;

        bool hasTargetCell = tryGetCells(gridPosition, out Cell targetCell);

        if (hasTargetCell == true && targetCell.tileType != null && targetCell.tileType.isMultiTile == true) {

            obstacleType = targetCell.tileType;

        }

        bool hasParentNeighbor = checkForParentNeighbor(gridPosition, out TileType parentTypeFound, out Vector2Int parentPosition, out int targetChildIndex);

        if (hasParentNeighbor == true) {

            anchorPosition = parentPosition;
            obstacleType = parentTypeFound;

        }

        if (obstacleType == null || obstacleType.isMultiTile == false) {

            targetFootprint.Add(gridPosition);
            return targetFootprint;

        }

        targetFootprint.Add(anchorPosition);

        if (obstacleType.multiTileShape != null) {

            int rotationSteps = getRotationStepsForPosition(anchorPosition, obstacleType);

            foreach (var shapePart in obstacleType.multiTileShape) {

                if (shapePart.offset == Vector2Int.zero) {

                    continue;

                }

                Vector2Int rotatedOffset = rotateOffset(shapePart.offset, rotationSteps);
                targetFootprint.Add(anchorPosition + rotatedOffset);

            }
        }

        return targetFootprint;

    }

    // ============================================================
    // Logical Prediction (For Grid Highlighter)
    // ============================================================

    public TileType getPredictedEnemyAt(Vector2Int gridPosition) {

        BiomeCellData targetCellData = biomeGenerator.getBiomeDataAt(gridPosition);

        if (GridStateManager.Instance != null) {

            bool isObstacleDestroyed = GridStateManager.Instance.isObstacleDestroyedAt(gridPosition);
            bool isEntityDestroyed = GridStateManager.Instance.isEntityDestroyedAt(gridPosition);

            if (isObstacleDestroyed == true || isEntityDestroyed == true) {

                targetCellData.obstacleType = null;
                targetCellData.enemyType = null;
                targetCellData.entityType = null;

            }
        }

        MultiTileLayer detectedLayer = MultiTileLayer.None;
        bool isWalkable = true;
        bool isGhostChild = false;

        bool hasParentNeighbor = checkForParentNeighbor(gridPosition, out TileType parentTypeFound, out Vector2Int anchorPosition, out int targetChildIndex);

        if (hasParentNeighbor == true) {

            bool isParentValid = true;

            if (GridStateManager.Instance != null && GridStateManager.Instance.isObstacleDestroyedAt(gridPosition) == true) {

                isParentValid = false;

            }

            if (isParentValid == true) {

                Vector2Int logicalOffset = gridPosition - anchorPosition;
                int rotationSteps = getRotationStepsForPosition(anchorPosition, parentTypeFound);
                int counterRotation = (4 - rotationSteps) % 4;

                Vector2Int originalOffset = rotateOffset(logicalOffset, counterRotation);
                detectedLayer = parentTypeFound.getLayerAt(originalOffset);

                if (detectedLayer != MultiTileLayer.multiTileBorder) {

                    isGhostChild = true;

                    if (detectedLayer == MultiTileLayer.noWalkable) {

                        isWalkable = false;

                    }

                    targetCellData.obstacleType = null;
                    targetCellData.entityType = null;

                }
            }
        }

        if (isGhostChild == false && targetCellData.obstacleType != null) {

            bool isLocallyWater = false;

            if (targetCellData.groundType != null && targetCellData.groundType.isWater == true) {

                isLocallyWater = true;

            }

            bool isValidLocation = true;

            if (targetCellData.obstacleType.mustSpawnOnWater == true && isLocallyWater == false) {

                isValidLocation = false;

            }

            else if (targetCellData.obstacleType.canSpawnOnWater == false && targetCellData.obstacleType.mustSpawnOnWater == false && isLocallyWater == true) {

                isValidLocation = false;

            }

            if (isValidLocation == true) {

                if (targetCellData.obstacleType.isMultiTile == true) {

                    if (isObstacleValid(gridPosition, targetCellData.obstacleType) == true) {

                        detectedLayer = targetCellData.obstacleType.getLayerAt(Vector2Int.zero);

                        if (detectedLayer == MultiTileLayer.noWalkable) {

                            isWalkable = false;

                        }
                    }

                    else {

                        targetCellData.obstacleType = null;

                    }
                }

                else {

                    if (targetCellData.obstacleType.isWalkable == false) {

                        isWalkable = false;

                    }
                }
            }

            else {

                targetCellData.obstacleType = null;

            }
        }

        if (targetCellData.groundType != null && targetCellData.groundType.isWalkable == false) {

            isWalkable = false;

        }

        TileType biomeSuggestedEnemy = null;

        if (detectedLayer == MultiTileLayer.forceEnemySpawn) {

            biomeSuggestedEnemy = biomeGenerator.getForcedEnemyAt(gridPosition);

        }

        else if (isWalkable == true) {

            if (detectedLayer == MultiTileLayer.None || detectedLayer == MultiTileLayer.multiTileBorder) {

                biomeSuggestedEnemy = targetCellData.enemyType;

            }
        }

        if (GridStateManager.Instance != null) {

            return GridStateManager.Instance.getEnemySpawnAt(gridPosition, biomeSuggestedEnemy);

        }

        return biomeSuggestedEnemy;

    }
