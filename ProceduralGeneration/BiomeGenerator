    public void clearFrameCache() {

        frameDataCache.Clear();
        waterCache.Clear();
        enemyLeaderCache.Clear();
        deterministicSectorCache.Clear();

    }

    public void clearDistantPredictionCache(Vector2Int currentCenter, int safeDistance) {

        keysToRemoveCache.Clear();
        float safeSquared = safeDistance * safeDistance;

        foreach (Vector2Int position in discoveredGroupSizeCache.Keys) {

            if ((position - currentCenter).sqrMagnitude > safeSquared) {

                keysToRemoveCache.Add(position);

            }
        }

        foreach (Vector2Int position in keysToRemoveCache) {

            discoveredEnemyTypeCache.Remove(position);
            discoveredGroupSizeCache.Remove(position);

        }

        keysToRemoveCache.Clear();

        foreach (Vector2Int position in discoveredLeaderCache.Keys) {

            if ((position - currentCenter).sqrMagnitude > safeSquared) {

                keysToRemoveCache.Add(position);

            }
        }

        foreach (Vector2Int position in keysToRemoveCache) {

            discoveredLeaderCache.Remove(position);

        }
    }
