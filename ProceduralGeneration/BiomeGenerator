    // Prediction Helpers
    // ============================================================

    private int getRotationStepsPrediction(Vector2Int position, TileType type) {

        if (type.randomRotationSteps == false) {

            return 0;

        }

        int hash = position.x * 73856093 ^ position.y * 19349663;
        System.Random pseudoRandomNumberGenerator = new System.Random(hash);

        return pseudoRandomNumberGenerator.Next(0, 4);

    }

    private Vector2Int rotateOffsetPrediction(Vector2Int offset, int steps) {

        Vector2Int result = offset;

        for (int i = 0; i < steps; i = i + 1) {

            int oldX = result.x;
            result.x = result.y;
            result.y = -oldX;

        }

        return result;

    }

