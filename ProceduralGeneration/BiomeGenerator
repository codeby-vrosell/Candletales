    private int getSpacingForLayer(int layerIndex) {

        switch (layerIndex) {

            case 0: return merchantSpacing;
            case 1: return goblinSpacing;
            case 2: return bonfireSpacing;
            case 3: return chestSpacing;
            case 4: return slimeSpacing;
            case 5: return mimicSpacing;

            default: return 10;
        }
    }

    private int getSaltForLayer(int layerIndex) {

        switch (layerIndex) {

            case 0: return 1111;
            case 1: return 2222;
            case 2: return 3333;
            case 3: return 4444;
            case 4: return 5555;
            case 5: return 6666;

            default: return 9999;

        }
    }

    private TileType getTileForLayer(Vector2Int position, int layerIndex) {

        BiomeConfig configuration = getBiomeConfigAt(position);

        if (configuration == null) {

            return null;

        }

        switch (layerIndex) {

            case 0: return configuration.specificTraderTile;
            case 1: return configuration.specificGoblinTile;
            case 2: return configuration.specificBonfireTile;
            case 3: return configuration.specificChestTile;
            case 4: return configuration.specificSlimeTile;
            case 5: return configuration.specificMimicTile;

            default: return null;

        }
    }

    public TileType getSlimeTileAt(Vector2Int gridPosition) {

        BiomeConfig configuration = getBiomeConfigAt(gridPosition);

        if (configuration != null) {

            return configuration.specificSlimeTile;

        }

        return null;

    }

    private int getRawBiomeIndexForChunk(Vector2Int chunk) {

        int hash = chunk.x * 73856093 ^ chunk.y * 19349663 ^ seed;
        System.Random localRandom = new System.Random(hash);

        localRandom.NextDouble();
        localRandom.NextDouble();

        return localRandom.Next(0, biomes.Length);

    }

    // ============================================================
    // Random Creators
    // ============================================================

    private float getPseudoRandom(int x, int y) {

        int hash = x * 73856093 ^ y * 19349663 ^ seed;
        hash = (hash << 13) ^ hash;

        return (1.0f - ((hash * (hash * hash * 15731 + 789221) + 1376312589) & 0x7fffffff) / 1073741824.0f) * 0.5f + 0.5f;

    }

    private int getFastRandomInt(int seedValue, int minimum, int maximum) {

        uint state = (uint)seedValue;

        state = state ^ (state << 13);
        state = state ^ (state >> 17);
        state = state ^ (state << 5);

        ulong range = (ulong)((long)maximum - (long)minimum);
        uint randomValue = state;

        return (int)(minimum + (long)(randomValue % range));

    }

