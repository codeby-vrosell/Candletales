    public void registerSlimeDestroyedAt(Vector2Int gridPosition) {

        bool isSlimeDestroyed = destroyedSlimes.Contains(gridPosition);

        if (isSlimeDestroyed == false) {

            destroyedSlimes.Add(gridPosition);

        }

