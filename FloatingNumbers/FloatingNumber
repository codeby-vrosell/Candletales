// ============================================================
// Readme of FloatingNumber
// ============================================================ 

// ============================================================
// Description
// ============================================================

This script controls the visual behavior and animation of floating numbers instantiated during gameplay.
It provides immediate feedback for the tactical combat system, displaying damage values, critical hits from dice rolls, misses, and specific cycle modifiers such as Blood Moon bonuses.

// ============================================================
// Responsibilities
// ============================================================

- Updates the text, icon, and color of the floating feedback based on the specific event.
- Animates the scale and alpha transparency over time using cubic and back easing functions.
- Alternates the initial rotation angle slightly for overlapping numbers to ensure readability.
- Dynamically adjusts the Z-test rendering depth when UI panels are active.
- Automatically destroys the GameObject once its designated lifetime expires.

// ============================================================
// End of readme
// ============================================================  

using TMPro;
using UnityEngine;
using UnityEngine.UI;

public class FloatingNumber : MonoBehaviour {

    // ============================================================
    // Core Components
    // ============================================================

    public TMP_Text textMesh;
    public RawImage iconImage;

    // ============================================================
    // Enemy & Player Icon Settings
    // ============================================================

    [Header("Enemy Icon Settings")]
    public Texture normalIconTexture;
    public Texture criticalIconTexture;

    [Header("Player Icon Settings")]
    public Texture playerNormalIconTexture;

    // ============================================================
    // Timing & Flash Settings
    // ============================================================

    [Header("Timing Settings")]
    public float lifeTime;
    public float popDuration;
    public float settleDuration;

    [Header("Flash Settings")]
    public float pureWhiteDuration;
    public float colorFadeDuration;

    // ============================================================
    // Color & Position Settings
    // ============================================================

    [Header("Color Settings")]
    public Color normalColor;
    public Color criticalColor;

    [Header("Random Position Settings")]
    public Vector2 xSpawnRange;
    public Vector2 ySpawnRange;
    public Vector2 rotationAngles;

    // ============================================================
    // Scale Settings
    // ============================================================

    [Header("Scale Settings (Damage)")]
    public float startScale;
    public float peakScale;
    public float criticalScaleMultiplier;

    [SerializeField] private Vector2 normalScaleRange;

    // ============================================================
    // Luck Bonus Settings
    // ============================================================

    [Header("Luck Bonus Settings")]
    public Color luckColor = Color.green;
    public Texture luckIconTexture;
    public float luckLifeTime;
    public Vector2 luckXSpawnRange;
    public Vector2 luckYSpawnRange;

    [Header("Luck Scale Settings")]
    public float luckStartScale;
    public float luckPeakScale;
    public Vector2 luckNormalScaleRange;

    // ============================================================
    // Blood Moon Bonus Settings
    // ============================================================

    [Header("Blood Moon Bonus Settings")]
    public Color bloodMoonColor = Color.red;
    public Texture bloodMoonIconTexture;
    public float bloodMoonLifeTime;
    public Vector2 bloodMoonXSpawnRange;
    public Vector2 bloodMoonYSpawnRange;

    [Header("Blood Moon Scale Settings")]
    public float bloodMoonStartScale;
    public float bloodMoonPeakScale;
    public Vector2 bloodMoonNormalScaleRange;

    // ============================================================
    // Miss Settings
    // ============================================================

    [Header("Miss Settings")]
    public Color missColor = Color.gray;
    public Texture missIconTexture;
    public float missLifeTime;
    public Vector2 missXSpawnRange;
    public Vector2 missYSpawnRange;

    [Header("Miss Scale Settings")]
    public float missStartScale;
    public float missPeakScale;
    public Vector2 missNormalScaleRange;

    // ============================================================
    // Internal State
    // ============================================================

    private float timer;
    private float currentPeakScale;
    private float targetZRotation;
    private float chosenNormalScale;
    private float activeLifeTime;
    private float activeStartScale;

    private Vector3 baseScale;
    private Vector3 worldOffset;

    private Camera mainCamera;
    private Color finalColor;

    private static bool toggleRotation = false;
    private Transform targetTransform;

    private Material iconMaterialClone;
    private bool wasPanelVisible = false;

    void Awake() {

        if (textMesh == null) {

            textMesh = GetComponentInChildren<TMP_Text>();

        }

        if (iconImage == null) {

            iconImage = GetComponentInChildren<RawImage>();

        }

        if (iconImage != null) {

            iconMaterialClone = new Material(iconImage.material);
            iconImage.material = iconMaterialClone;

        }

        setZRenderDepth(8);

        mainCamera = Camera.main;
        targetTransform = transform.parent;
        transform.SetParent(null);
        baseScale = transform.localScale;

    }

    void Update() {

        timer = timer + Time.deltaTime;

        updateDamageAnimation();
        checkUIState();

    }

    // ============================================================
    // Damage Logic
    // ============================================================

    public void setValue(int amount, bool isCritical, bool isPlayer = false) {

        if (textMesh == null) {

            return;

        }

        activeLifeTime = lifeTime;
        activeStartScale = startScale;

        worldOffset = new Vector3(Random.Range(xSpawnRange.x, xSpawnRange.y), Random.Range(ySpawnRange.x, ySpawnRange.y), 0f);

        if (targetTransform != null) {

            transform.position = targetTransform.position + worldOffset;

        }

        else {

            transform.position = transform.position + worldOffset;

        }

        if (toggleRotation == true) {

            targetZRotation = rotationAngles.y;

        }

        else {

            targetZRotation = rotationAngles.x;

        }

        if (toggleRotation == true) {

            toggleRotation = false;

        }

        else {

            toggleRotation = true;

        }

        chosenNormalScale = Random.Range(normalScaleRange.x, normalScaleRange.y);
        textMesh.text = amount.ToString();

        if (isCritical == true) {

            finalColor = criticalColor;
            currentPeakScale = peakScale * criticalScaleMultiplier;

            if (iconImage != null) {

                iconImage.texture = criticalIconTexture;

            }
        }

        else {

            finalColor = normalColor;
            currentPeakScale = peakScale;

            if (iconImage != null) {

                if (isPlayer == true) {

                    iconImage.texture = playerNormalIconTexture;

                }

                else {

                    iconImage.texture = normalIconTexture;

                }
            }
        }

        textMesh.color = Color.white;

        if (iconImage != null) {

            iconImage.color = Color.white;

        }

        transform.localScale = baseScale * activeStartScale;

    }

    // ============================================================
    // Bonus Logic (Luck & Blood Moon)
    // ============================================================

    public void setLuckBonus(int amount) {

        setupBonus(amount, luckColor, luckIconTexture, luckXSpawnRange, luckYSpawnRange, luckStartScale, luckPeakScale, luckNormalScaleRange, luckLifeTime);

    }

    public void setBloodMoonBonus(int amount) {

        setupBonus(amount, bloodMoonColor, bloodMoonIconTexture, bloodMoonXSpawnRange, bloodMoonYSpawnRange, bloodMoonStartScale, bloodMoonPeakScale, bloodMoonNormalScaleRange, bloodMoonLifeTime);

    }

    private void setupBonus(int amount, Color targetColor, Texture iconTexture, Vector2 xRange, Vector2 yRange, float startScaleParameter, float peakScaleParameter, Vector2 normalScaleRangeParameter, float maxLifeTimeParameter) {

        if (textMesh == null) {

            return;

        }

        activeLifeTime = maxLifeTimeParameter;
        activeStartScale = startScaleParameter;

        worldOffset = new Vector3(Random.Range(xRange.x, xRange.y), Random.Range(yRange.x, yRange.y), 0f);

        if (targetTransform != null) {

            transform.position = targetTransform.position + worldOffset;

        }

        else {

            transform.position = transform.position + worldOffset;

        }

        if (toggleRotation == true) {

            targetZRotation = rotationAngles.y;

        }

        else {

            targetZRotation = rotationAngles.x;

        }

        if (toggleRotation == true) {

            toggleRotation = false;

        }

        else {

            toggleRotation = true;

        }

        chosenNormalScale = Random.Range(normalScaleRangeParameter.x, normalScaleRangeParameter.y);
        currentPeakScale = peakScaleParameter;
        textMesh.text = "+" + amount.ToString();
        finalColor = targetColor;
        textMesh.color = Color.white;

        if (iconImage != null) {

            iconImage.texture = iconTexture;
            iconImage.color = Color.white;

        }

        transform.localScale = baseScale * activeStartScale;

    }

    // ============================================================
    // Miss Logic
    // ============================================================

    public void setMiss() {

        if (textMesh == null) {

            return;

        }

        activeLifeTime = missLifeTime;
        activeStartScale = missStartScale;

        worldOffset = new Vector3(Random.Range(missXSpawnRange.x, missXSpawnRange.y), Random.Range(missYSpawnRange.x, missYSpawnRange.y), 0f);

        if (targetTransform != null) {

            transform.position = targetTransform.position + worldOffset;

        }

        else {

            transform.position = transform.position + worldOffset;

        }

        if (toggleRotation == true) {

            targetZRotation = rotationAngles.y;

        }

        else {

            targetZRotation = rotationAngles.x;

        }

        if (toggleRotation == true) {

            toggleRotation = false;

        }

        else {

            toggleRotation = true;

        }

        chosenNormalScale = Random.Range(missNormalScaleRange.x, missNormalScaleRange.y);
        currentPeakScale = missPeakScale;
        textMesh.text = "Missed!";
        finalColor = missColor;

        if (iconImage != null) {

            iconImage.texture = missIconTexture;

        }

        textMesh.color = Color.white;

        if (iconImage != null) {

            iconImage.color = Color.white;

        }

        transform.localScale = baseScale * activeStartScale;

    }

    // ============================================================
    // Unified Animation Logic (Hit Effect)
    // ============================================================

    private void updateDamageAnimation() {

        if (targetTransform != null) {

            transform.position = targetTransform.position + worldOffset;

        }

        float timeFraction = Mathf.Clamp01(timer / Mathf.Max(0.0001f, activeLifeTime));
        float popTimeFraction = Mathf.Clamp01(timer / Mathf.Max(0.0001f, popDuration));

        float currentZRotation = Mathf.LerpUnclamped(0f, targetZRotation, outBackAnimation(popTimeFraction));

        if (mainCamera != null) {

            transform.rotation = mainCamera.transform.rotation * Quaternion.Euler(0f, 0f, currentZRotation);

        }

        scaleAnimation();
        fadeAnimation(timeFraction);

        if (timer >= activeLifeTime) {

            Destroy(gameObject);

        }
    }

    private void scaleAnimation() {

        if (timer <= popDuration) {

            float timeFraction = Mathf.Clamp01(timer / Mathf.Max(0.0001f, popDuration));
            float currentScale = Mathf.Lerp(activeStartScale, currentPeakScale, outBackAnimation(timeFraction));
            
            transform.localScale = baseScale * currentScale;

            return;

        }

        float settleStart = popDuration;
        float settleEnd = popDuration + settleDuration;

        if (timer <= settleEnd) {

            float timeFraction = Mathf.Clamp01((timer - settleStart) / Mathf.Max(0.0001f, settleDuration));
            float currentScale = Mathf.Lerp(currentPeakScale, chosenNormalScale, outCubicAnimation(timeFraction));
            
            transform.localScale = baseScale * currentScale;

            return;

        }

        transform.localScale = baseScale * chosenNormalScale;

    }

    private void fadeAnimation(float timeFraction) {

        if (textMesh == null) {

            return;

        }

        Color currentColor = textMesh.color;

        if (timer <= pureWhiteDuration) {

            currentColor = Color.white;

        }

        else if (timer <= pureWhiteDuration + colorFadeDuration) {

            float colorTimeFraction = Mathf.Clamp01((timer - pureWhiteDuration) / Mathf.Max(0.0001f, colorFadeDuration));
            currentColor = Color.Lerp(Color.white, finalColor, colorTimeFraction);

        }

        else {

            currentColor.r = finalColor.r; 
            currentColor.g = finalColor.g; 
            currentColor.b = finalColor.b;

        }

        float fadeTimeFraction = Mathf.Clamp01((timeFraction - 0.45f) / 0.55f);
        currentColor.a = Mathf.Lerp(1f, 0f, fadeTimeFraction);

        textMesh.color = currentColor;

        if (iconImage != null) {

            iconImage.color = currentColor;

        }
    }

    private float outCubicAnimation(float timeFraction) {

        timeFraction = Mathf.Clamp01(timeFraction);

        return 1f - Mathf.Pow(1f - timeFraction, 3f);

    }

    private float outBackAnimation(float timeFraction) {

        timeFraction = Mathf.Clamp01(timeFraction);
        
        float constant1 = 1.70158f;
        float constant3 = constant1 + 1f;

        return 1f + constant3 * Mathf.Pow(timeFraction - 1f, 3f) + constant1 * Mathf.Pow(timeFraction - 1f, 2f);

    }

    // ============================================================
    // Dynamic ZTest Logic
    // ============================================================

    private void checkUIState() {

        if (BlurPaneles.Instance == null) {

            return;

        }

        bool isPanelVisible = BlurPaneles.Instance.Visible;

        if (isPanelVisible != wasPanelVisible) {

            wasPanelVisible = isPanelVisible;
            int zTestValue;

            if (isPanelVisible == true) {

                zTestValue = 4;

            }

            else {

                zTestValue = 8;

            }

            setZRenderDepth(zTestValue);

        }
    }

    private void setZRenderDepth(int value) {

        if (textMesh != null) {

            textMesh.fontMaterial.SetInt("unity_GUIZTestMode", value);

        }

        if (iconMaterialClone != null) {

            iconMaterialClone.SetInt("unity_GUIZTestMode", value);

        }
    }
}
